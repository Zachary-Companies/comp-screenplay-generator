{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": ".build",
    "declaration": false
  },
  "include": [
    "woodbury.d.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    ".build"
  ]
}